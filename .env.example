# ==============================================================
# WireGuard + AdGuard Home Configuration
# ==============================================================

# IP Publik atau Domain VPS / Server Anda.
# Gunakan "auto" untuk mendeteksi IP publik secara otomatis,
# atau isi dengan IP VPS (contoh: 103.150.90.10) / domain (contoh: vpn.domainanda.com)
SERVERURL=auto

# Port WireGuard VPN (default UDP 51820)
SERVERPORT=51820

# Daftar Client / Peer yang akan dibuat otomatis:
# Bisa berupa angka (misal: 3) -> akan membuat client1, client2, client3
# ATAU berupa nama-nama dipisah koma (misal: phone,laptop,pc)
PEERS=phone,laptop

# Port Web Dashboard AdGuard Home di dalam kontainer (default: 3000)
WEB_PORT=3000

# Port Web Dashboard AdGuard Home di Host/komputer Anda (misal: 3000 atau 3001 jika port 3000 bentrok)
WEB_PORT_HOST=3000

# Akun Login Web Dashboard AdGuard Home (http://<IP-SERVER>:3000)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Subnet IP Internal WireGuard (default: 10.13.13.0/24)
INTERNAL_SUBNET=10.13.13.0/24

# Timezone (contoh: Asia/Jakarta, UTC, Asia/Singapore)
TZ=Asia/Jakarta
